      "name": "Config session",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [360, 300]
    },
    {
      "parameters": {
        "jsCode": "const queries = [\n  { query: 'site:linkedin.com/in \"fondateur\" \"agence Google Ads\" France -freelance', label: 'Google Ads' },\n  { query: 'site:linkedin.com/in \"CEO\" OR \"co-fondateur\" \"agence SEA\" France -freelance', label: 'SEA' },\n  { query: 'site:linkedin.com/in \"fondateur\" \"agence performance\" \"Google Ads\" France', label: 'Performance' },\n  { query: 'site:linkedin.com/in \"fondateur\" \"Meta Ads\" OR \"Facebook Ads\" agence France -freelance', label: 'Meta Ads' },\n  { query: 'site:linkedin.com/in \"fondateur\" \"paid social\" agence France -freelance', label: 'Paid Social' },\n  { query: 'site:linkedin.com/in \"fondateur\" \"Google Premier Partner\" agence France', label: 'Premier Partner' },\n  { query: 'site:linkedin.com/in \"fondateur\" \"agence acquisition\" OR \"lead generation\" \"Google Ads\" France', label: 'Acquisition' },\n  { query: 'site:linkedin.com/in \"fondateur\" \"media buying\" OR \"achat media\" agence France -freelance', label: 'Media Buying' }\n];\n\nreturn queries.map((q) => ({ json: q }));"
      },
      "id": "da002222-0002-4aaa-9000-a1b2c3d4e5f6",
      "name": "Générer requêtes SEA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": { "reset": false }
      },
      "id": "da002222-0003-4aaa-9000-a1b2c3d4e5f6",
      "name": "Boucle requêtes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://google.serper.dev/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { q: $json.query, num: 10, gl: 'fr', hl: 'fr' } }}",
        "options": {
          "retry": { "enabled": true, "maxTries": 3, "waitBetweenTries": 1500 },
          "timeout": 20000
        }
      },
