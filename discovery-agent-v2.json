        "httpHeaderAuth": { "id": "REMPLACER_ID_CREDENTIAL_SERPER", "name": "Serper API Key" }
      },
      "id": "da002222-0004-4aaa-9000-a1b2c3d4e5f6",
      "name": "Chercher LinkedIn (Serper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": { "amount": 2, "unit": "seconds" },
      "id": "da002222-0004b-4aaa-9000-a1b2c3d4e5f6",
      "name": "Pause anti-spam",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1060, 300],
      "webhookId": "pause-serper-v2-3"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.allProfiles) staticData.allProfiles = [];\n\nconst data = $input.item.json;\nif (data.error || data.message) {\n  return [{ json: { profils_accumules: staticData.allProfiles.length, skipped: true } }];\n}\n\nconst results = data.organic || [];\nconst label = $('Boucle requêtes').item.json.label || 'search';\nconst blacklist = ['automatisation', 'no-code', 'make.com', 'zapier', 'n8n', 'automation agency'];\n\nfor (const r of results) {\n  const title = r.title || '';\n  const link = (r.link || '').split('?')[0];\n  const snippet = r.snippet || '';\n  if (!link.includes('linkedin.com/in')) continue;\n\n  const parts = title.split(' - ');\n  const nom = parts[0]?.trim() || '';\n  const poste = parts[1]?.trim() || '';\n  const agence = parts[2]?.replace(/\\|.*$/, '').trim() || '';\n  if (!nom || nom.length < 3) continue;\n\n  const snippetLower = snippet.toLowerCase();\n  if (blacklist.some((w) => snippetLower.includes(w))) continue;\n\n  staticData.allProfiles.push({\n    nom,\n    poste,\n    agence,\n    linkedin_url: link,\n    snippet: snippet.substring(0, 200),\n    source: label\n  });\n}\n\nreturn [{ json: { profils_accumules: staticData.allProfiles.length } }];"
      },
      "id": "da002222-0005-4aaa-9000-a1b2c3d4e5f6",
      "name": "Extraire et accumuler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst all = staticData.allProfiles || [];\nstaticData.allProfiles = [];\nstaticData.profileByUrl = {};\n\nconst seen = new Set();\nconst unique = [];\nfor (const p of all) {\n  const url = (p.linkedin_url || '').split('?')[0];\n  if (!url || seen.has(url)) continue;\n  seen.add(url);\n  const row = { ...p, linkedin_url: url };\n  unique.push(row);\n  staticData.profileByUrl[url] = row;\n}\n\nreturn [{ json: { profiles: unique, total: unique.length } }];"
      },
      "id": "da002222-0006-4aaa-9000-a1b2c3d4e5f6",
      "name": "Dédupliquer profils",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "cond-has-profiles",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "da002222-0006b-4aaa-9000-a1b2c3d4e5f6",
      "name": "Profils trouvés ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1520, 300]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config session').item.json;\nconst maxIcp = cfg.max_profils_icp || 30;\nconst allProfiles = $input.item.json.profiles || [];\nconst profiles = allProfiles.slice(0, maxIcp);\nconst truncated = allProfiles.length > maxIcp;\n\nconst systemPrompt = `Tu es un expert en qualification de prospects B2B pour des agences SEA et performance marketing françaises.\nÉvalue chaque profil LinkedIn selon les 5 critères ICP ci-dessous.\nRéponds UNIQUEMENT en JSON valide strict (tableau), sans markdown.\n\nCRITÈRES ICP SEA (un seul NON = ÉLIMINÉ) :\nQ1 — Activité principale SEA/performance (Google/Meta/paid social/SEA/acquisition payante)\nQ2 — Taille agence estimée 8–40 (sinon inclure avec note)\nQ3 — Décideur : Fondateur, Co-fondateur, CEO, Président, DG, Associé gérant uniquement\nQ4 — France uniquement\nQ5 — Pas une agence dont l'offre principale est l'automation/IA/no-code pour clients\n\nDOULEUR :\n\"P-MON — Monitoring\" → Google/Meta/paid social pure-play\n\"P08 — Reporting\" → multi-plateformes\nLISTE : \"A-list\" ou \"B-list\"\nRecopie snippet et source du JSON d'entrée pour chaque ligne.\n\nFORMAT : [{\"nom\":\"\",\"agence\":\"\",\"linkedin_url\":\"\",\"poste\":\"\",\"snippet\":\"\",\"source\":\"\",\"qualifie\":true,\"raison_elimination\":null,\"douleur_probable\":\"P-MON — Monitoring\",\"liste\":\"A-list\"}]`;\n\nreturn [{\n  json: {\n    profiles_count: profiles.length,\n    profiles_total_serper: allProfiles.length,\n    icp_truncated: truncated,\n    claude_request: {\n      model: 'claude-sonnet-4-6',\n      max_tokens: 8000,\n      system: systemPrompt,\n      messages: [{ role: 'user', content: `Évalue ces ${profiles.length} profils :\\n${JSON.stringify(profiles)}` }]\n    }\n  }\n}];"
      },
      "id": "da002222-0007-4aaa-9000-a1b2c3d4e5f6",
      "name": "Préparer requête Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1640, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.claude_request }}",
        "options": {
          "retry": { "enabled": true, "maxTries": 3, "waitBetweenTries": 2000 },
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REMPLACER_ID_CREDENTIAL_CLAUDE", "name": "Claude API Key" }
      },
      "id": "da002222-0008-4aaa-9000-a1b2c3d4e5f6",
      "name": "Évaluer ICP (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1860, 220]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\nconst text = response.content?.[0]?.text;\nif (!text) throw new Error('Réponse Claude invalide');\n\nlet raw = text.trim();\nif (raw.startsWith('```')) raw = raw.replace(/```json?\\n?/g, '').replace(/```$/g, '').trim();\n\nlet evaluated;\ntry {\n  evaluated = JSON.parse(raw);\n} catch (e) {\n  throw new Error('JSON Claude invalide : ' + raw.substring(0, 280));\n}\n\nconst staticData = $getWorkflowStaticData('global');\nconst byUrl = staticData.profileByUrl || {};\n\nconst enriched = evaluated.map((p) => {\n  const url = (p.linkedin_url || '').split('?')[0];\n  const src = byUrl[url] || {};\n  return {\n    ...p,\n    linkedin_url: url,\n    snippet: p.snippet || src.snippet || '',\n    source: p.source || src.source || ''\n  };\n});\n\nconst allQualifies = enriched.filter((p) => p.qualifie === true);\nconst cfg = $('Config session').item.json;\nconst maxNew = cfg.max_nouveaux_prospects || 10;\nconst qualifies = allQualifies.slice(0, maxNew);\n\nconsole.log(`ICP : ${qualifies.length} retenus / ${allQualifies.length} qualifiés / ${enriched.length - allQualifies.length} éliminés (max session ${maxNew})`);\n\nreturn [{\n  json: {\n    qualifies,\n    total_qualifies: qualifies.length,\n    total_qualifies_icp: allQualifies.length,\n    total_evalues: enriched.length\n  }\n}];"
      },
      "id": "da002222-0009-4aaa-9000-a1b2c3d4e5f6",
      "name": "Parser qualifiés ICP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2080, 220]
