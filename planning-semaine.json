        "url": "={{ 'https://api.notion.com/v1/pages/' + $json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Notion-Version", "value": "2022-06-28" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyType": "raw",
        "body": "={{ JSON.stringify({ properties: { 'Date envoi': { date: { start: $json.date_envoi } }, 'Date J+2': { date: { start: $json.date_j2 } }, 'Date J+5': { date: { start: $json.date_j5 } } } }) }}",
        "options": {
          "timeout": 30000,
          "batching": { "batch": { "batchSize": 1, "batchInterval": 300 } }
        }
      },
      "credentials": {
        "notionApi": { "id": "REMPLACER_ID_NOTION_CREDENTIAL", "name": "Notion account" }
      }
    },
    {
