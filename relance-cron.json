      }
    },
    {
      "id": "rc-skip-j5-001",
      "name": "Skip J+5 (aucun)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 600],
      "parameters": {}
    }
  ],
